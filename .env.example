# SitePro AI — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha apenas o que for usar.
# Nenhuma dessas chaves é exposta ao navegador — todas são lidas somente no servidor
# (API Routes), nunca em componentes client-side.

# --- Descoberta de empresas ---
# Chave gratuita (sem cartão) em https://openwebninja.com — usada para buscar
# empresas reais (Local Business Data API, com dados vindos do Google Maps).
# Sem esta chave, o sistema funciona normalmente em MODO DEMONSTRAÇÃO.
OPENWEBNINJA_API_KEY=

# Alternativa/futuro: Google Places API (exige cartão de crédito na conta Google Cloud)
GOOGLE_PLACES_API_KEY=

# --- Banco de imagens (fallback quando a empresa não tem fotos públicas) ---
PEXELS_API_KEY=

# --- Geração de conteúdo por IA (textos do site) ---
# Quando não configurada, o sistema usa um gerador de textos baseado em templates.
ANTHROPIC_API_KEY=

# --- WhatsApp Business (opcional, para futura automação de envio) ---
WHATSAPP_API_TOKEN=

# --- Hospedagem (opcional, para publicação automatizada futura) ---
VERCEL_API_TOKEN=
NETLIFY_API_TOKEN=

# --- Banco de dados (opcional — sem isso, usa armazenamento local em arquivo) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Outros ---
PORT=3000
